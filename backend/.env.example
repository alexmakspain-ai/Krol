# Local dev: run `docker compose up -d` from the repo root, then this
# matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://expense_tracker:expense_tracker@localhost:5432/expense_tracker

# SQLite still works for quick throwaway testing without Docker:
# DATABASE_URL=sqlite:///./expense_tracker.db

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
